{
  "name": "umalytics",
  "version": "0.5.4",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @umalytics/extension dev",
    "build": "pnpm --filter @umalytics/extension build",
    "build:all": "node scripts/build-all.mjs && pnpm --filter @umalytics/desktop build",
    "package:release": "node scripts/package-release.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "sync:umas": "node scripts/sync-uma-data.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "linkedom": "0.18.14"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
