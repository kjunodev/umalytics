{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UmaLytics",
  "version": "0.5.4",
  "identifier": "guide.umalytics.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "UmaLytics", "width": 1000, "height": 740 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "plugins": { "http": { "scopeRedirects": true } },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
