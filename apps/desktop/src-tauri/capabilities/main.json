{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local desktop feed, profile persistence, and the drafter API.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-save",
    { "identifier": "http:default", "allow": [{ "url": "https://drafter-api.uma.guide/*" }] }
  ]
}
